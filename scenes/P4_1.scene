# ============================================================================
# PIEZA CENTRAL: PEDESTAL HIPERBOLOIDE (CUADRATICA + CLIP) + GLOBO PLANETARIO
# ============================================================================

# Hiperboloide de una hoja dorado-bronce centrado en (0, -1.65, 11.0)
# (x^2 + (z-11)^2)/0.72^2 - (y+1.65)^2/0.85^2 = 1
QUADRIC 1.92901235 -1.38408305 1.92901235 0.0 0.0 0.0 0.0 -2.28373702 -21.21913580 228.64232774 0.88 0.68 0.30 0.20 0.74 0.88 90.0 0.72 0.28 0.00 0
CLIP 0.0  1.0 0.0  2.50
CLIP 0.0 -1.0 0.0 -0.80

# Aro superior del pedestal (Disco con radio interno dejando ver el interior del hiperboloide)
DISK 0.0 -0.80 11.0 0.0 1.0 0.0 1.15 0.86 0.90 0.72 0.34 0.20 0.74 0.80 90.0 0.75 0.25 0.00 0

# Globo planetario terrestre despejado y brillante (Textura en Esfera)
SPHERE 0.0 1.55 11.0 1.65 1.0 1.0 1.0 0.28 0.84 0.40 45.0 0.94 0.06 0.00 3

# Anillo planetario translucido inclinado (Disco con radio interno + Transparencia no refractiva)
DISK 0.0 1.55 11.0 -0.18 0.90 -0.40 2.85 2.02 0.94 0.82 0.50 0.24 0.68 0.60 65.0 0.42 0.10 0.48 0

# ============================================================================
# LADO IZQUIERDO: ESFERA HUECA RECORTADA (CLIP) + NUCLEO + CRISTAL + ELIPSE
# ============================================================================

# Esfera azul cobalto seccionada por plano diagonal mostrando interior hueco (Esfera + CLIP)
SPHERE -4.2 -0.85 9.6 1.62 0.16 0.40 0.82 0.20 0.82 0.68 75.0 0.82 0.18 0.00 0
CLIP -0.45 -0.52 0.72 -8.395

# Nucleo dorado reflejante suspendido dentro de la esfera hueca
SPHERE -4.2 -0.85 9.6 0.72 0.96 0.76 0.28 0.20 0.74 0.92 100.0 0.55 0.45 0.00 0

# Peana circular bajo la esfera recortada (Disco)
DISK -4.2 -2.47 9.6 0.0 1.0 0.0 1.28 0.0 0.22 0.26 0.35 0.20 0.75 0.55 50.0 0.80 0.20 0.00 0

# Esfera de cristal transparente en primer plano izquierdo (Transparencia no refractiva + sombra atenuada)
SPHERE -2.35 -1.45 6.4 1.05 0.52 0.84 1.00 0.12 0.48 0.95 100.0 0.20 0.10 0.70 0

# Medallon eliptico espejo flotando arriba a la izquierda (Elipse + Espejo)
ELLIPSE -4.2 2.75 11.2 0.34 -0.14 -0.93 0.93 0.05 0.34 1.45 0.88 0.86 0.89 0.95 0.08 0.22 0.85 100.0 0.14 0.86 0.00 0

# ============================================================================
# LADO DERECHO: CONOS TEXTURIZADOS (.AVS) + CONO RECORTADO + ELIPSE + CRISTAL
# ============================================================================

# Aguja / reloj de sol conico principal (Cono + Textura en Conos desde .avs)
CONE 4.45 2.15 10.6 0.0 -1.0 0.0 17.5 0.0 4.65 1.0 1.0 1.0 0.24 0.82 0.42 50.0 0.92 0.08 0.00 5

# Base circular para el cono principal (Disco)
DISK 4.45 -2.48 10.6 0.0 1.0 0.0 1.65 0.0 0.82 0.66 0.30 0.20 0.74 0.70 80.0 0.75 0.25 0.00 0

# Cono inclinado truncado y recortado separado limpiamente mostrando textura y hueco (Cono + CLIP)
CONE 2.15 -2.25 8.5 -0.45 0.89 0.0 20.0 0.45 2.45 1.0 1.0 1.0 0.24 0.82 0.45 55.0 0.90 0.10 0.00 5
CLIP 0.0 0.0 1.0 -8.35

