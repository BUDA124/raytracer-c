# PR04-CG - ESCENA 2: DOS PUERCOESPINES AMERICANOS (Erethizon dorsatum) EN EL BOSQUE
# Escena limpia que conserva unicamente:
# - Cesped / suelo del bosque (textures/forest_floor.ppm)
# - Fondo del bosque de coniferas con bruma (textures/forest_backdrop.ppm)
# - Arboles enmarcando el claro (textures/tree_bark.ppm)
# - Puercoespin 1 (trasero) inclinado verticalmente ~45 grados
# - Puercoespin 2 (delantero, al frente en +X) a 0 grados de inclinacion

WINDOW -7.8 -4.560 7.8 4.560
EYE 10.4000 1.6500 -11.6000
LOOKAT 0.4500 -0.5800 9.0000 0.0 1.0 0.0
RES 1300 760
DEPTH 5
AA 2

BG 0.58 0.72 0.78
AMBIENT 0.31 0.31 0.31

# 3 luces blancas puntuales (sol matutino calibrado sin sombras en el fondo, relleno suave y contraluz)
LIGHT  8.2 10.5 -6.0 0.96 0.96 0.96 1.0 0.006 0.0
LIGHT  6.2  3.8 -5.5 0.42 0.42 0.42 1.0 0.013 0.0
LIGHT -0.5  9.8 14.5 0.62 0.62 0.62 1.0 0.010 0.0

# Texturas utilizadas (1-based: 1..5)
TEXTURE 1 textures/forest_floor.ppm
TEXTURE 2 textures/forest_backdrop.ppm
TEXTURE 3 textures/tree_bark.ppm
TEXTURE 4 textures/porcupine_quill.ppm
TEXTURE 5 textures/porcupine_fur.ppm

# ============================================================================
# ENTORNO: CESPED DEL BOSQUE, FONDO DE CONIFERAS Y ARBOLES
# ============================================================================

